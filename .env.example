# ==============================================================================
# Smriti - Industrial Memory OS Environment Variables
# Copy this file to .env and configure for local development.
# ==============================================================================

# --- Backend Configuration ---
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///database/smriti.db
PRAGMA_JOURNAL_MODE=WAL

# --- AI & Extraction (Hosted LLM API) ---
# Set the provider: 'gemini' or 'anthropic' (default: gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Proactive Alerts & Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ALERT_CONFIDENCE_THRESHOLD=0.5
TELEMETRY_POLL_INTERVAL_SECONDS=5

# --- Frontend Configuration ---
# Public API URL for frontend (Client-side requests)
NEXT_PUBLIC_API_URL=http://localhost:8000
